# Copy this file to .env and fill in your values
# Never commit your actual .env file

# Required: Groq API key, used by the AI agent (server/agent/chat.js)
# Groq's API is free (no credit card required) - get a key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional: override the model used by the agent (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Port the server listens on
PORT=3000
